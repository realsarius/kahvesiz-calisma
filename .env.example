# cp .env.example .env

# =====================================
# Kahvesiz Çalışma - Environment Sample
# =====================================

# Application Environment
ENVIRONMENT=development
APP_DOMAIN=localhost

# Shared Auth
SECRET_KEY=change-this-to-32-byte-random
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_EXPIRE_DAYS=30
MAGIC_LINK_EXPIRE_MINUTES=15

# JWT Configuration (opsiyonel / ileri faz)
JWT_SECRET_KEY=change-this-to-64-byte-random
JWT_ISSUER=KahvesizAPI
JWT_AUDIENCE=KahvesizAPI
JWT_EXPIRATION_MINUTES=60

# CORS / Host
ALLOWED_HOSTS=localhost;127.0.0.1;kahvesizcalisma.com

# ---------- Development ----------
# Primary URLs used by app/compose
DATABASE_URL_DEV=postgresql+asyncpg://user:pass@db-dev:5432/kahvesiz_dev
REDIS_URL_DEV=redis://redis-dev:6379/0
FRONTEND_URL_DEV=http://localhost:5173
ALLOWED_ORIGINS_DEV=http://localhost:5173,http://localhost

# Optional split DB variables (documentation / parity style)
DATABASE_DEV_HOST=localhost
DATABASE_DEV_PORT=5432
DATABASE_DEV_NAME=kahvesiz_dev
DATABASE_DEV_USER=user
DATABASE_DEV_PASSWORD=pass

# Legacy (Strangler)
LEGACY_SQLALCHEMY_DATABASE_URI=sqlite:///cafes.db
LEGACY_AUTO_CREATE_SCHEMA=false
LEGACY_WTF_CSRF_ENABLED=true
LEGACY_SOLID_DIST_DIR=frontend-solid/dist

# Compose service credentials (dev)
POSTGRES_DEV_DB=kahvesiz_dev
POSTGRES_DEV_USER=user
POSTGRES_DEV_PASSWORD=pass

# Dev published ports
FRONTEND_DEV_PORT=5173
NGINX_DEV_PORT=80

# ---------- Test ----------
POSTGRES_TEST_DB=kahvesiz_test
POSTGRES_TEST_USER=user
POSTGRES_TEST_PASSWORD=pass
POSTGRES_TEST_PORT=55432
REDIS_TEST_PORT=56379

DATABASE_TEST_HOST=localhost
DATABASE_TEST_PORT=5433
DATABASE_TEST_NAME=kahvesiz_test
DATABASE_TEST_USER=user
DATABASE_TEST_PASSWORD=pass

# ---------- Production ----------
# Primary URLs used by app/compose
DATABASE_URL_PROD=postgresql+asyncpg://user:pass@db-prod:5432/kahvesiz
REDIS_URL_PROD=redis://redis-prod:6379/0
FRONTEND_URL_PROD=https://kahvesizcalisma.com
ALLOWED_ORIGINS_PROD=https://kahvesizcalisma.com

# Optional split DB variables (documentation / parity style)
DATABASE_PROD_HOST=localhost
DATABASE_PROD_PORT=5434
DATABASE_PROD_NAME=kahvesiz
DATABASE_PROD_USER=user
DATABASE_PROD_PASSWORD=pass

# Legacy (Strangler, prod)
LEGACY_SQLALCHEMY_DATABASE_URI_PROD=sqlite:///cafes.db
LEGACY_AUTO_CREATE_SCHEMA_PROD=false
LEGACY_WTF_CSRF_ENABLED_PROD=true
LEGACY_SOLID_DIST_DIR_PROD=frontend-solid/dist

# Compose service credentials (prod)
POSTGRES_PROD_DB=kahvesiz
POSTGRES_PROD_USER=user
POSTGRES_PROD_PASSWORD=pass

# Runtime
API_WORKERS=2
NGINX_PROD_PORT=80

# ---------- Email ----------
EMAIL_PROVIDER=Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kahvesizcalisma.com
EMAIL_FROM_NAME=Kahvesiz Çalışma
EMAIL_BASE_URL=http://localhost:5173

# ---------- KVKK / Privacy ----------
# 32+ karakter önerilir. Uygulamada aktif kullanım planı için yer ayrıldı.
KVKK_ENCRYPTION_KEY=change-me-32-char-min-key
KVKK_HASH_PEPPER=change-me-hash-pepper
KVKK_CONSENT_VERSION=v1
PII_RETENTION_DAYS=3650

# ---------- Redis / Rate Limit ----------
RATE_LIMIT_PER_MINUTE=120
SESSION_CACHE_ENABLED=true

# ---------- Feature Flags ----------
FEATURE_ENABLE_MAGIC_LINK=true
FEATURE_ENABLE_LEGACY_LOGIN=true
FEATURE_ENABLE_SEEDED_DEV_DATA=true
